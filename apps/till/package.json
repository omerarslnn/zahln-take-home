{
  "name": "@mensa/till",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start --port 8082",
    "android": "expo start --android --go --port 8082",
    "ios": "expo start --ios --go --port 8082",
    "bundle": "expo export --platform android --platform ios --output-dir dist --clear",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.1.1",
    "@mensa/api": "workspace:*",
    "@mensa/domain": "workspace:*",
    "@mensa/shared": "workspace:*",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "expo": "~54.0.38",
    "expo-constants": "~18.0.14",
    "expo-crypto": "~15.0.9",
    "expo-dev-client": "~6.0.21",
    "expo-localization": "~17.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-status-bar": "~3.0.9",
    "nativewind": "4.2.7",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-css-interop": "0.2.7",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "7.29.7",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.1.17",
    "babel-preset-expo": "~54.0.12",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3"
  },
  "expo": {
    "autolinking": {
      "android": {
        "exclude": [
          "expo-dev-client",
          "expo-dev-launcher",
          "expo-dev-menu",
          "expo-dev-menu-interface",
          "expo-manifests",
          "expo-updates-interface",
          "expo-json-utils"
        ]
      }
    }
  }
}
