# Copy to .env (`pnpm env:init` does it). EXPO_PUBLIC_* values are inlined into the JavaScript
# bundle at build time and can be read from the installed app. Never put secrets or tokens here.
EXPO_PUBLIC_API_BASE_URL=https://dev.zahln.de
# Data namespace from the API email. Public by design: it is sent as X-Candidate-Id on every request.
EXPO_PUBLIC_CANDIDATE_ID=c_5b3ceacafb
