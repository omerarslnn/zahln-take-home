# Copy to .env (`pnpm env:init` does it). VITE_* values are inlined into the JavaScript bundle at
# build time and are readable by anyone who loads the dashboard. Never put secrets or tokens here.
VITE_API_BASE_URL=https://dev.zahln.de
# Data namespace from the API email. Public by design: it is sent as X-Candidate-Id on every request.
VITE_CANDIDATE_ID=c_5b3ceacafb
# Public demo login: the password of the mock API's seeded `finance` account, published in the
# "Seeded logins" table of the OpenAPI description. It is bundled public mock data, not a secret,
# and a production dashboard would ship no password at all. Set it deliberately in .env (or in the
# host's build settings); `vite build` stops with a message while it is empty.
VITE_SEEDED_PASSWORD=
