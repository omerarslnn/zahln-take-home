# Copy to .env (`pnpm env:init` does it). VITE_* values are inlined into the JavaScript bundle at
# build time and are readable by anyone who loads the dashboard. Never put secrets or tokens here.
VITE_API_BASE_URL=https://dev.zahln.de
# Data namespace from the API email. Public by design: it is sent as X-Candidate-Id on every request.
VITE_CANDIDATE_ID=c_5b3ceacafb
