# Copy to .env (`pnpm env:init` does it). Read only by local scripts (pnpm api:smoke,
# pnpm api:spec-diff); never bundled into an app. Each app has its own .env.example.
ZAHLN_API_BASE_URL=https://dev.zahln.de
ZAHLN_CANDIDATE_ID=c_5b3ceacafb

# Seeded account for the smoke check: student, staff or guest.
ZAHLN_SMOKE_USERNAME=student
# Keep this empty here. Put the seeded password from the "Seeded logins" table of the OpenAPI
# description into your local .env (or pass it on the command line) only.
ZAHLN_SMOKE_PASSWORD=

# Browser origins whose CORS preflight the smoke check simulates (Vite dev and preview).
ZAHLN_SMOKE_ORIGINS=http://localhost:5173,http://localhost:4173
