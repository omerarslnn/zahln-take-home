# Dependencies and caches
node_modules/
.pnpm-store/
.expo/
.metro-health-check*
*.tsbuildinfo
coverage/

# Build output
dist/
artifacts/
web-build/

# Local recovery records written by scripts (e.g. the order probe)
.local/

# Native projects are generated by `expo prebuild` (Continuous Native Generation).
# They contain generated signing material (debug.keystore), so they are never committed.
apps/*/android/
apps/*/ios/
expo-env.d.ts

# Local environment. Only the *.env.example files are committed.
.env
.env.*
!.env.example

# Credentials and signing material must never be committed.
*.keystore
*.jks
*.p8
*.p12
*.pem
*.key
*.mobileprovision
credentials.json
google-services.json
GoogleService-Info.plist

# Built mobile artifacts
*.apk
*.aab
*.ipa

# Original task sources stay local: they include private correspondence and a copied job page.
# The API contract used by the code is committed at packages/api/openapi/openapi.json.
brief/

# OS / editor noise
.DS_Store
*.log
.idea/
.vscode/*
!.vscode/extensions.json
